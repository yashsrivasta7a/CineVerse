{
  "expo": {
    "name": "cineverse",
    "slug": "cineverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "cineverse",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yashsrivasta7a.cineverse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#D12129"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yashsrivasta7a.cineverse"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#251711",
          "dark": {
            "backgroundColor": "#251711"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Thunder-BlackLC.ttf",
            "./assets/fonts/Thunder-BoldLC.ttf"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "151cad44-3cfe-44de-ae39-84430ed001db"
      },
      "expo-navigation-bar": {
        "style": "light",
        "hidden": true
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yash.ys7",
    "updates": {
      "url": "https://u.expo.dev/151cad44-3cfe-44de-ae39-84430ed001db"
    }
  }
}
