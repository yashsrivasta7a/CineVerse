{
  "expo": {
    "name": "cineverse",
    "slug": "cineverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "cineverse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yashsrivasta7a.cineverse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#D12129"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yashsrivasta7a.cineverse"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#251711",
          "dark": {
            "backgroundColor": "#251711"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Thunder-BlackLC.ttf",
            "./assets/fonts/Thunder-BoldLC.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58be218d-2ba1-4d24-88d5-fcef5cb0a2e9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/58be218d-2ba1-4d24-88d5-fcef5cb0a2e9"
    }
  }
}
